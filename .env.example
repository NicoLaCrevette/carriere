# Copie ce fichier en `.env` (jamais commité). Tout est facultatif :
# sans rien, le jeu tourne sur ses textes pré-écrits, et si Ollama tourne sur
# ta machine, le proxy le détecte tout seul et s'en sert (gratuit).

# ── Fournisseur de dialogues ────────────────────────────────────────────
# auto (défaut) : Ollama s'il répond, sinon Mistral si une clé est là, sinon
# Anthropic si une clé est là, sinon les textes pré-écrits.
# Valeurs possibles : auto | ollama | mistral | anthropic
LLM_PROVIDER=auto
# Adresse du serveur Ollama local (défaut : http://127.0.0.1:11434)
OLLAMA_URL=http://127.0.0.1:11434

# ── Mistral (facultatif, palier gratuit) ────────────────────────────────
# Modèles français natifs, rien à installer, aucune carte demandée sur le
# palier « Experiment » : https://console.mistral.ai
# La même clé sert ensuite à la version en ligne, via la fonction de `edge/`.
MISTRAL_API_KEY=
# Modèles (défauts ci-dessous). `mistral-large-latest` sert aux grands moments.
# MISTRAL_MODEL_COURANT=mistral-small-latest
# MISTRAL_MODEL_PREMIUM=mistral-large-latest

# ── API Anthropic (facultative, payante) ────────────────────────────────
# Lue UNIQUEMENT par le proxy local (server/proxy.ts), jamais par le navigateur.
# Peut aussi être saisie dans l'écran Réglages du jeu.
ANTHROPIC_API_KEY=

# ── Voix ElevenLabs (facultative, payante) ──────────────────────────────
# Les voix du navigateur sont utilisées par défaut et ne coûtent rien.
ELEVENLABS_API_KEY=

# Port du proxy (le front Vite relaie /api vers ce port)
PROXY_PORT=8787
