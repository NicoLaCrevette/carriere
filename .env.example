# Copie ce fichier en `.env` (jamais commité). Tout est facultatif :
# sans rien, le jeu tourne sur ses textes pré-écrits, et si Ollama tourne sur
# ta machine, le proxy le détecte tout seul et s'en sert (gratuit).

# ── Fournisseur de dialogues ────────────────────────────────────────────
# auto (défaut) : Ollama s'il répond, sinon Mistral si une clé est là, sinon
# Anthropic si une clé est là, sinon les textes pré-écrits.
# Valeurs possibles : auto | ollama | mistral | anthropic
LLM_PROVIDER=auto
# Adresse du serveur Ollama local (défaut : http://127.0.0.1:11434)
OLLAMA_URL=http://127.0.0.1:11434

# ── Fournisseur hébergé compatible OpenAI (facultatif, paliers gratuits) ─
# Rien à installer, et la même clé sert ensuite à la version en ligne (edge/).
# N'importe lequel fait l'affaire : prends celui où tu arrives à ouvrir un compte.
#
#   Mistral   https://api.mistral.ai/v1                             mistral-small-latest
#             console.mistral.ai — modèles français natifs, le meilleur ici
#   Groq      https://api.groq.com/openai/v1                        llama-3.3-70b-versatile
#             console.groq.com — très rapide
#   Google    https://generativelanguage.googleapis.com/v1beta/openai  gemini-2.0-flash
#             aistudio.google.com — palier gratuit généreux, bon en français
#   Cerebras  https://api.cerebras.ai/v1                            llama-3.3-70b
#
LLM_API_KEY=
# Défaut : Mistral. À changer selon le fournisseur choisi ci-dessus.
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL_COURANT=mistral-small-latest
# LLM_MODEL_PREMIUM=mistral-large-latest

# ── API Anthropic (facultative, payante) ────────────────────────────────
# Lue UNIQUEMENT par le proxy local (server/proxy.ts), jamais par le navigateur.
# Peut aussi être saisie dans l'écran Réglages du jeu.
ANTHROPIC_API_KEY=

# ── Voix ElevenLabs (facultative, payante) ──────────────────────────────
# Les voix du navigateur sont utilisées par défaut et ne coûtent rien.
ELEVENLABS_API_KEY=

# Port du proxy (le front Vite relaie /api vers ce port)
PROXY_PORT=8787
